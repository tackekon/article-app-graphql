{
  "compilerOptions": {
    "target": "ES6", // cho phép biên dịch code Typescript sang kiểu ES6
    "module": "commonjs", // commonJS là tiêu chuẩn được sử dụng trong NodeJS để làm việc với các module
    "removeComments": true, // xoá comments khi biên dịch sang file js
    "esModuleInterop": true, // Dùng được từ khoá import thay cho require
    "outDir": "dist",
    "strict": false,  // Tắt các kiểm tra nghiêm ngặt (giúp bỏ qua phần lớn lỗi kiểu dữ liệu)
    "noImplicitAny": false,  // Cho phép các biến/thuộc tính nhận kiểu any ẩn
    "skipLibCheck": true, // Bỏ qua kiểm tra lỗi trong các thư viện node_modules
  }
}